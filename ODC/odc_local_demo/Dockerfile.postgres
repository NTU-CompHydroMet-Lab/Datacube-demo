FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        postgresql \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/local_postgres_entrypoint.sh /usr/local/bin/local_postgres_entrypoint.sh
RUN chmod +x /usr/local/bin/local_postgres_entrypoint.sh

EXPOSE 5432

CMD ["/usr/local/bin/local_postgres_entrypoint.sh"]
